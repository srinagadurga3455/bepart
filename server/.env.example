# Required - Phase 1
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/pravesh?schema=public
JWT_SECRET=replace-with-a-secure-jwt-secret
JWT_EXPIRES_IN=7d
PORT=3000
APP_URL=http://localhost:3000

# Optional with defaults
NODE_ENV=development
API_PREFIX=api
BCRYPT_SALT_ROUNDS=10

# Optional auth
JWT_REFRESH_SECRET=replace-with-a-secure-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:5173
STORAGE_PROVIDER=local

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Cloudflare R2 event posters (optional locally; required in production or
# uploads store mock URLs that browsers cannot load).
# NEVER commit real keys. R2_ENDPOINT is account-level with NO bucket suffix.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bepart
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<your-bucket-public-host>.r2.dev

# Razorpay (leave empty until enabled; never commit real secrets)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Amazon SES transactional email (optional; OTP/ticket/settlement emails are
# skipped with a warning when unset; never commit real secrets)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# Meta WhatsApp Cloud API (optional; ticket/settlement/OTP messages are
# skipped with a warning when unset; never commit real tokens)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v26.0

# Admin settlement alerts (optional; skipped when unset)
ADMIN_WHATSAPP_NUMBER=