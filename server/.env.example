# Required - Phase 1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pravesh?schema=public
JWT_SECRET=your-super-secret-jwt-key-min-16-chars-change-in-production
JWT_EXPIRES_IN=7d
PORT=3000
APP_URL=http://localhost:3000

# Optional with defaults
NODE_ENV=development
API_PREFIX=api
BCRYPT_SALT_ROUNDS=10

# Optional auth
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:5173
STORAGE_PROVIDER=local

# Admin bootstrap (used by seed)
ADMIN_EMAIL=admin@pravesh.local
ADMIN_PASSWORD=Admin@123