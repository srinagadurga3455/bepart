generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  password         String?
  name             String
  phone            String?
  role             Role       @default(STUDENT)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  organizerProfile Organizer?

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model OtpVerification {
  id         String     @id @default(cuid())
  identifier String
  otpHash    String
  purpose    OtpPurpose
  expiresAt  DateTime
  attempts   Int        @default(0)
  verified   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([identifier])
  @@index([expiresAt])
  @@map("otp_verifications")
}

model Admin {
  id          String      @id @default(cuid())
  companyName String
  description String?
  status      AdminStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  organizers  Organizer[]

  @@index([status])
  @@map("admins")
}

model Organizer {
  id          String          @id @default(cuid())
  name        String
  description String?
  phone       String?
  email       String?         @unique
  upiId       String?
  status      OrganizerStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String?         @unique
  adminId     String?
  events      Event[]
  admin       Admin?          @relation(fields: [adminId], references: [id])
  user        User?           @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
  @@index([adminId])
  @@index([email])
  @@map("organizers")
}

model Event {
  id              Int            @id @default(autoincrement())
  eventName       String
  description     String?
  date            DateTime
  slots           Int
  closingTime     DateTime
  status          EventStatus    @default(DRAFT)
  formStructure   Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organizerId     String
  posterUrl       String?
  paymentRequired Boolean        @default(false)
  organizer       Organizer      @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  registrations   Registration[]

  @@index([organizerId])
  @@index([status])
  @@index([date])
  @@map("events")
}

model Registration {
  registrationId String        @id @default(cuid())
  phone          String
  formData       Json?
  paymentStatus  PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  eventId        Int
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payment        Payment?

  @@index([eventId])
  @@index([phone])
  @@map("registrations")
}

model Payment {
  id               String        @id @default(cuid())
  registrationId   String?       @unique
  amount           Int           @default(0)
  status           PaymentStatus @default(PENDING)
  razorpayOrderId  String?
  razorpayPaymentId String?
  phone            String?
  eventId          Int?
  pendingFormData  Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  registration     Registration? @relation(fields: [registrationId], references: [registrationId], onDelete: Cascade)

  @@index([registrationId])
  @@index([status])
  @@index([phone])
  @@index([eventId])
  @@index([razorpayOrderId])
  @@map("payments")
}

enum Role {
  STUDENT
  ORGANIZER
  ADMIN
}

enum OrganizerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
}

enum EventStatus {
  DRAFT
  PREVIEW
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OtpPurpose {
  ADMIN_LOGIN
  ORGANIZER_LOGIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}
