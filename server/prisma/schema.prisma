// Pravesh - Prisma Schema — Updated to Required Design
// Preserves User for Auth/RBAC, implements Admin/Organizer/Event/Registration as per spec

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────
// Enums (kept only where needed)
// ─────────────────────────────────────
enum Role {
  STUDENT
  ORGANIZER
  ADMIN
}

enum OrganizerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
}

enum EventStatus {
  DRAFT
  PREVIEW
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum TicketStatus {
  VALID
  CHECKED_IN
  CANCELLED
}

// ─────────────────────────────────────
// Core Models — Preserved User for Auth/RBAC
// ─────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String
  phone     String?
  role      Role     @default(STUDENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizerProfile Organizer?
  coupons          Coupon[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

enum OtpPurpose {
  ADMIN_LOGIN
  ORGANIZER_LOGIN
}

model OtpVerification {
  id         String     @id @default(uuid())
  identifier String
  otpHash    String
  purpose    OtpPurpose
  expiresAt  DateTime
  attempts   Int        @default(0)
  verified   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([identifier])
  @@index([expiresAt])
  @@map("otp_verifications")
}

model Admin {
  id          String      @id @default(uuid())
  companyName String
  description String?     @db.Text
  phone       String?
  status      AdminStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organizers Organizer[]

  @@index([status])
  @@map("admins")
}

model Organizer {
  id          String          @id @default(uuid())
  name        String
  description String?         @db.Text
  phone       String?
  email       String?         @unique
  upiId       String?
  status      OrganizerStatus @default(PENDING)
  // Admin-controlled visibility: deactivation sets isActive=false and cascades
  // to the organizer's events; reactivation restores both.
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations: preserve link to User for RBAC + Admin management
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  adminId String?
  admin   Admin?  @relation(fields: [adminId], references: [id], onDelete: SetNull)

  events Event[]

  withdrawals Withdrawal[]

  @@index([status])
  @@index([isActive])
  @@index([userId])
  @@index([adminId])
  @@index([email])
  @@map("organizers")
}

model Event {
  id                 String      @id @default(uuid())
  eventName          String
  description        String?     @db.Text
  date               DateTime
  slots              Int
  closingTime        DateTime
  status             EventStatus @default(DRAFT)
  // Visibility switch controlled by organizer deactivation cascade.
  // Public listing/registration only include isActive events.
  isActive           Boolean     @default(true)
  formStructure      Json?
  posterSquareUrl    String?
  posterRectangleUrl String?
  paymentRequired    Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  registrations Registration[]
  coupons       Coupon[]
  withdrawals   Withdrawal[]
  tickets       Ticket[]

  @@index([organizerId])
  @@index([status])
  @@index([isActive])
  @@index([date])
  @@map("events")
}

model Registration {
  registrationId String        @id @default(uuid())
  phone          String
  formData       Json?
  paymentStatus  PaymentStatus @default(PENDING)
  // QR check-in: set when an organizer/admin scans the ticket at entry.
  checkedInAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  payment Payment?

  ticket Ticket?

  // Coupon pricing snapshot (nullable so pre-feature registrations stay valid).
  // STORAGE is Int paise; the API speaks rupees (₹500 <-> 50000) and services
  // convert at the boundary (see src/common/utils/money.ts).
  // originalAmount = price before discount, discountAmount = discount applied,
  // totalAmount = final amount actually payable (what the payment gateway gets).
  couponId       String?
  coupon         Coupon? @relation("RegistrationCoupon", fields: [couponId], references: [id], onDelete: SetNull)
  couponCode     String?
  originalAmount Int?
  discountAmount Int?    @default(0)
  totalAmount    Int?

  @@index([eventId])
  @@index([phone])
  @@index([couponId])
  @@map("registrations")
}

// Organizer fund settlement: organizer requests withdrawal of collected
// registration fees per event; admin pays manually and uploads proof.
// STORAGE is Int paise (e.g. 50000 = ₹500.00); the API speaks rupees and
// services convert at the boundary (see src/common/utils/money.ts).
model Withdrawal {
  id              String           @id @default(uuid())
  amount          Int
  upiId           String
  status          WithdrawalStatus @default(REQUESTED)
  transactionId   String?
  proofUrl        String?
  rejectionReason String?
  requestedAt     DateTime         @default(now())
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  notifications WithdrawalNotification[]

  @@index([organizerId])
  @@index([eventId])
  @@index([status])
  @@map("withdrawals")
}

model Payment {
  id              String        @id @default(uuid())
  registrationId  String?       @unique
  registration    Registration? @relation(fields: [registrationId], references: [registrationId], onDelete: Cascade)
  amount          Int           @default(0)
  status          PaymentStatus @default(PENDING)
  // Pending payment holding form data for paid events (before Registration is created)
  phone           String?
  eventId         String?
  pendingFormData Json?
  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  // Denormalized code snapshot: survives coupon deletion/rename.
  couponCode      String?
  // Pricing audit (STORAGE Int paise; API rupees): amount is ALWAYS the final
  // payable amount. originalAmount = event price before discount,
  // discountAmount = discount applied.
  originalAmount  Int?
  discountAmount  Int?          @default(0)
  // Razorpay integration (order creation + webhook verification).
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([registrationId])
  @@index([status])
  @@index([eventId])
  @@index([phone])
  @@index([couponId])
  @@index([razorpayOrderId])
  @@map("payments")
}

model Coupon {
  id            String             @id @default(uuid())
  // Normalized uppercase (e.g. AICLUB20). Lookup uppercases + trims input,
  // so aiclub20 / AICLUB20 / AiClub20 resolve to the same coupon.
  code          String             @unique
  eventId       String
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId     String?
  student       User?              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  phone         String?
  discountType  CouponDiscountType
  discountValue Int
  // Lifecycle / limits. Legacy single-use coupons use isUsed; coupons with
  // usageLimit use the atomic usedCount counter (isUsed mirrors exhaustion).
  isActive      Boolean            @default(true)
  isUsed        Boolean            @default(false)
  usedAt        DateTime?
  usedCount     Int                @default(0)
  usageLimit    Int?
  startsAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  payments      Payment[]
  registrations Registration[]     @relation("RegistrationCoupon")

  @@index([eventId])
  @@index([studentId])
  @@index([phone])
  @@index([code])
  @@index([isUsed])
  @@index([isActive])
  @@map("coupons")
}

// Event ticket issued automatically when a registration completes
// (free event, or paid event with PAID payment). The public ticket code +
// QR token are random UUIDs (never sequential IDs). QR data is the public
// ticketUrl; no image is stored. Check-in flips status to CHECKED_IN and
// mirrors checkedInAt onto the registration for legacy views.
model Ticket {
  id             String       @id @default(uuid())
  // Public ticket identifier used in URLs, QR scans and check-in APIs.
  code           String       @unique @default(uuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [registrationId], onDelete: Cascade)
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketUrl      String
  // Secure token accepted by the check-in APIs as an alternative to code.
  qrToken        String       @unique @default(uuid())
  status         TicketStatus @default(VALID)
  checkedInAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Reverse side of the WhatsApp delivery audit relation (no extra column).
  whatsappDeliveries WhatsappDelivery[]

  @@index([eventId])
  @@index([status])
  @@map("tickets")
}

enum WhatsappDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum WithdrawalNotificationKind {
  PAYOUT_REQUEST
  PAYOUT_SUCCESS
  PAYOUT_REJECTED
}

enum WithdrawalNotificationStatus {
  PENDING
  SENT
  FAILED
}

// Idempotency + audit record for the post-payment ticket confirmation sent
// over Meta WhatsApp Cloud API. One row per ticket (ticketId unique), so
// webhook replays, retries and repeated requests can never double-send.
// A FAILED row never affects the payment, registration or ticket.
model WhatsappDelivery {
  id                String                  @id @default(uuid())
  ticketId          String                  @unique
  ticket            Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  phone             String
  status            WhatsappDeliveryStatus  @default(PENDING)
  providerMessageId String?
  attempts          Int                     @default(0)
  lastError         String?                 @db.Text
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status])
  @@map("whatsapp_deliveries")
}

// Audit record for payout/withdrawal WhatsApp side effects (organizer
// payout request -> admin, payout paid/rejected -> organizer). One row per
// send attempt; a FAILED row never affects the withdrawal itself.
model WithdrawalNotification {
  id                String                       @id @default(uuid())
  withdrawalId      String
  withdrawal        Withdrawal                   @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  kind              WithdrawalNotificationKind
  to                String
  template          String
  status            WithdrawalNotificationStatus @default(PENDING)
  providerMessageId String?
  attempts          Int                          @default(0)
  lastError         String?                      @db.Text
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([withdrawalId])
  @@index([status])
  @@map("withdrawal_notifications")
}
